# Sao chép thành .env và điền giá trị. KHÔNG commit .env lên Git.
# GEMINI_API_KEY bắt buộc để chạy thật; nếu bỏ trống backend chạy mock mode.

# --- Gemini ---
GEMINI_API_KEY=
# Audio (mic) được transcribe bằng faster-whisper local TRƯỚC khi gọi Gemini,
# nên Gemini chỉ cần nhận text → chọn gemini-3.5-flash-lite (nhanh + nhẹ).
# Lưu ý: gemini-2.5-flash trả 404 cho key mới; gemini-3.5-flash-lite KHÔNG nhận
# audio (500) nhưng text thì OK; gemini-3-flash-preview hết quota 20/ngày (429).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_TURNS=8
GEMINI_TEMPERATURE=0.7
# Gemini Thinking: 'minimal' | 'low' | 'medium' | 'high' | '' (tắt).
# 3.5-flash-lite HỖ TRỢ thinking (default minimal). Không tốn phí, không tốn quota.
# Grounding với Google Search KHÔNG dùng được trên free tier (429) — để tắt.
GEMINI_THINKING=minimal

# --- VOICEVOX (Phase 3+) ---
VOICEVOX_BASE_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=0

# --- STT faster-whisper (Phase 2+) ---
# Đổi cỡ model nếu cần: tiny | base | small | medium | large-v3 (small ~500MB)
WHISPER_MODEL=small
# Ngôn ngữ ưu tiên; bỏ trống để Whisper tự dò
WHISPER_LANGUAGE=ja

# --- RVC (Phase 4+) ---
RVC_WORKER_URL=http://127.0.0.1:8010
RVC_MODEL_NAME=

# --- Data ---
DATA_DIR=./data
TEMP_AUDIO_DIR=./temp
TEMP_TTL_SECONDS=3600

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Mock / offline ---
ALLOW_MOCK=true
MAX_AUDIO_BYTES=20971520
DEBUG=true
