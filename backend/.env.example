# Sao chép thành .env và điền giá trị. KHÔNG commit .env lên Git.
# GEMINI_API_KEY bắt buộc để chạy thật; nếu bỏ trống backend chạy mock mode.

# --- Gemini ---
GEMINI_API_KEY=
# Android dùng Google SpeechRecognizer và chỉ gửi transcript text xuống backend,
# nên Gemini chỉ cần model text nhanh, nhẹ và quota rộng.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_TURNS=8
GEMINI_TEMPERATURE=0.7
# Gemini Thinking: 'minimal' | 'low' | 'medium' | 'high' | '' (tắt).
# 3.5-flash-lite HỖ TRỢ thinking (default minimal). Không tốn phí, không tốn quota.
# Grounding với Google Search KHÔNG dùng được trên free tier (429) — để tắt.
GEMINI_THINKING=minimal

# --- Fish Audio online TTS ---
# Tạo key tại https://fish.audio/app/api-keys và chỉ lưu trong backend/.env.
FISH_API_KEY=
FISH_API_BASE_URL=https://api.fish.audio
FISH_MODEL=s2.1-pro-free
# Public Miku-like voice. Có thể thay bằng model ID khác trong Fish Voice Library.
FISH_REFERENCE_ID=3317b3ca88d74206b5478a22a2d502b9
# WAV giữ được mouth cues hiện tại; mp3/opus nhẹ hơn nhưng backend không tính RMS.
FISH_AUDIO_FORMAT=wav
FISH_AUDIO_PREROLL_MS=300
FISH_LATENCY=low
FISH_TIMEOUT=60
FISH_TEMPERATURE=0.7
FISH_TOP_P=0.7
FISH_EMOTION_TAGS=true

# --- Data ---
DATA_DIR=./data
TEMP_AUDIO_DIR=./temp
TEMP_TTL_SECONDS=3600

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Mock / offline ---
ALLOW_MOCK=true
DEBUG=true
