# Sao chép thành .env và điền giá trị. KHÔNG commit .env lên Git.
# GEMINI_API_KEY bắt buộc để chạy thật; nếu bỏ trống backend chạy mock mode.

# --- Gemini ---
GEMINI_API_KEY=
# Model tương thích key mới (hỗ trợ audio + JSON schema): gemini-3-flash-preview.
# Lưu ý: gemini-2.5-flash trả 404 cho key mới; gemini-flash-latest không nhận audio.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MAX_TURNS=8
GEMINI_TEMPERATURE=0.7

# --- VOICEVOX (Phase 3+) ---
VOICEVOX_BASE_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=0

# --- RVC (Phase 4+) ---
RVC_WORKER_URL=http://127.0.0.1:8010
RVC_MODEL_NAME=

# --- Data ---
DATA_DIR=./data
TEMP_AUDIO_DIR=./temp
TEMP_TTL_SECONDS=3600

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Mock / offline ---
ALLOW_MOCK=true
MAX_AUDIO_BYTES=20971520
DEBUG=true
