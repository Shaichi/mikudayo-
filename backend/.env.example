# Sao chép thành .env và điền giá trị. KHÔNG commit .env lên Git.
# GEMINI_API_KEY bắt buộc để chạy thật. Mock chỉ dùng cho development.

# --- Environment / API safety ---
ENVIRONMENT=development
DEBUG=true
# Để trống khi chạy local. Khi bật production, đặt token dài và bí mật.
API_TOKEN=
REQUIRE_AUTH=false
# CORS chỉ cần cho web/desktop; Flutter mobile không phụ thuộc CORS.
CORS_ORIGINS=*
TRUSTED_HOSTS=*
MAX_BODY_BYTES=65536
MAX_TEXT_LENGTH=2000
MAX_SCENARIO_LENGTH=240
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Gemini ---
GEMINI_API_KEY=
# Android dùng Google SpeechRecognizer và chỉ gửi transcript text xuống backend,
# nên Gemini chỉ cần model text nhanh, nhẹ và quota rộng.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_TURNS=8
GEMINI_TEMPERATURE=0.7
# Gemini Thinking: 'minimal' | 'low' | 'medium' | 'high' | '' (tắt).
# 3.5-flash-lite HỖ TRỢ thinking (default minimal). Không tốn phí, không tốn quota.
# Grounding với Google Search KHÔNG dùng được trên free tier (429) — để tắt.
GEMINI_THINKING=minimal

# --- Fish Audio online TTS ---
# Tạo key tại https://fish.audio/app/api-keys và chỉ lưu trong backend/.env.
FISH_API_KEY=
FISH_API_BASE_URL=https://api.fish.audio
FISH_MODEL=s2.1-pro-free
# Public Miku-like voice. Có thể thay bằng model ID khác trong Fish Voice Library.
FISH_REFERENCE_ID=3317b3ca88d74206b5478a22a2d502b9
# WAV giữ được mouth cues hiện tại; mp3/opus nhẹ hơn nhưng backend không tính RMS.
FISH_AUDIO_FORMAT=wav
FISH_AUDIO_PREROLL_MS=150
FISH_SAMPLE_RATE=24000
FISH_LATENCY=low
FISH_TIMEOUT=60
FISH_TEMPERATURE=0.7
FISH_TOP_P=0.7
FISH_EMOTION_TAGS=true
FISH_MAX_TEXT_LENGTH=1200
MAX_AUDIO_BYTES=15728640
FISH_RETRY_ATTEMPTS=3

# --- Data ---
DATA_DIR=./data
TEMP_AUDIO_DIR=./temp
TEMP_TTL_SECONDS=3600
DB_TIMEOUT_SECONDS=10
AUDIO_MAX_CONCURRENCY=2
AUDIO_STALE_SECONDS=300

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Mock / offline ---
ALLOW_MOCK=true

# --- Vocabulary Reinforcement & RAG Grammar Grounding ---
VOCAB_REINFORCEMENT_ENABLED=true
VOCAB_REINFORCEMENT_LIMIT=3
VOCAB_REINFORCEMENT_THRESHOLD=3
RAG_GRAMMAR_ENABLED=true
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIM=768
RAG_SIMILARITY_THRESHOLD=0.70
RAG_TIMEOUT_SECONDS=0.20
RAG_TOP_K=3
